{
  "lsp": true,
  "references": {
    "docs": {
      "path": "../07-DB-Schema",
      "description": "Esquema de base de datos, tablas, columnas y referencias a crear, esto no esta implementado en la base de datos, solo es para referencia"
    }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "environment": {
          "LD_LIBRARY_PATH": "/tmp/opencode/nss-libs/root/usr/lib/x86_64-linux-gnu"
        },
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chromium",
          "--headless"
        ]
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_MCP_PAT}"
        }
      }
    }
  }
}